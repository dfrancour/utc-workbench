{
  "name": "utc-workbench",
  "version": "0.0.1",
  "title": "UTC Workbench",
  "description": "Timestamp interpretation and timeline reconstruction for developer workflows",
  "icon": "icon.png",
  "author": "dfrancour",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "commands": [
    {
      "name": "utc-workbench",
      "title": "UTC Workbench",
      "description": "Interpret timestamps and reconstruct event timelines",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.93.2",
    "@raycast/utils": "^2.2.3",
    "luxon": "^3.6.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.1"
  },
  "scripts": {
    "build": "ray build --skip-types -e dist -o dist",
    "dev": "ray develop",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "publish": "npx @raycast/api@latest publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  }
}
